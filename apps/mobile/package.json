{
  "name": "mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "expo": "57.0.27",
    "expo-status-bar": "57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "5.10.1",
    "react-native-webview": "13.16.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "postinstall": "node scripts/variant.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test src/navigation.test.ts",
    "ios:broken": "node scripts/variant.mjs broken && expo prebuild --platform ios && expo run:ios --device",
    "ios:fixed": "node scripts/variant.mjs fixed && expo prebuild --platform ios && expo run:ios --device",
    "lint": "expo lint"
  },
  "private": true,
  "expo": {
    "install": {
      "exclude": [
        "react-native-webview"
      ]
    }
  }
}
